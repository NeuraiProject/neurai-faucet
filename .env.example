# NETWORK
# mainnet | testnet — selects which RPC_URL to use
NETWORK=testnet
RPC_URL_TESTNET=https://rpc-testnet.neurai.org/rpc
RPC_URL_MAINNET=https://rpc.neurai.org/rpc
# Optional: genesis block hash the RPC node must have. Defaults to the mainnet
# or testnet (2026-11-05) genesis; set it for regtest or a private network.
EXPECTED_GENESIS=

# FAUCET CONFIG
# Amount of NEURAI to send per request
FAUCET_AMOUNT=100
# Time to wait between requests in hours
WAIT_TIME_HOURS=24
# Maximum number of pending claims in the queue (excess requests get 503)
MAX_QUEUE_SIZE=50
# Minimum confirmations required before spending a UTXO. The node needs 100
# on mainnet and 5 on testnet for coinbase coins; 10 leaves a margin.
COINBASE_MATURITY=10
# Fee rate in satoshis per virtual byte, computed on the signed size (the node
# relays from 1000).
FEE_RATE_SAT_PER_VBYTE=2000
# 12 words of the wallet sending the funds
MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"
# Wallet type used to derive the faucet funding address from the mnemonic
# ecdsa  = strict ECDSA witness v3 (tnq1r…); the only type that can pay silent
#          payment codes (tnsp1…)
# legacy = Base58 P2PKH (t… / N…); the only type allowed on mainnet for now
# pq     = strict post-quantum witness v2 (tpq1z…)
FAUCET_WALLET_TYPE=ecdsa

# NEURAI CONNECT (Optional - claim by scanning a QR with NeuraiWallet)
# The public origin this faucet is served from. It is the domain the user signs
# and the audience of the login, so it must be configured here and is never
# taken from a Host header. Leave it empty to disable Neurai Connect entirely.
PUBLIC_SITE_URL=
# Relay the QR pairing travels through. It only forwards encrypted blobs.
CONNECT_RELAY_URL=wss://relay.neurai.org/v1
# How long a login stays open once the QR is on screen, in seconds
CONNECT_LOGIN_TTL_SECONDS=600
# How long a verified wallet may claim for, in seconds
CONNECT_TICKET_TTL_SECONDS=300

# ANTI-SPAM (Optional - Cloudflare Turnstile)
# NOTE: If these are left empty or set to the dummy values below, 
# Captcha verification will be automatically DISABLED in the backend.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# FRONTEND
# Port the faucet is published on. Keep it OUTSIDE the ephemeral range
# (/proc/sys/net/ipv4/ip_local_port_range, usually 32768-60999): a port inside
# it can be taken at random by any outgoing connection, and the container then
# fails to start with "address already in use".
FRONTEND_PORT=8080
# Interface the port is published on. 127.0.0.1 keeps the faucet reachable only
# through the reverse proxy on the host; use 0.0.0.0 to expose it directly.
FRONTEND_BIND=127.0.0.1
