---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Neurai Faucet">

  <!-- NAVBAR -->
  <nav class="navbar">
    <div class="navbar-left">
      <img src="/logo.png" alt="Neurai Logo" class="nav-logo" />
      <div class="nav-title-group">
        <span class="nav-eyebrow">FAUCET</span>
        <span class="nav-title">Neurai Faucet</span>
      </div>
    </div>
    <div class="navbar-right">
      <div class="network-pill">
        <span id="status-dot" class="dot"></span>
        <span id="network-label">Testnet</span>
      </div>
      <button id="theme-toggle" class="icon-btn" title="Toggle theme" aria-label="Toggle dark/light mode">
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
      </button>
    </div>
  </nav>

  <!-- MAIN CONTENT -->
  <main class="page-content">

    <!-- TOP ROW: Balance + Receiving Address -->
    <div class="top-row">

      <!-- Balance Card -->
      <div class="card balance-card">
        <div class="balance-header">
          <p class="card-label">FAUCET BALANCE</p>
          <span class="xna-badge">XNA</span>
        </div>
        <span id="faucet-balance" class="balance-big">—</span>
      </div>

      <!-- Receiving Address Card -->
      <div class="card address-card">
        <p class="card-label">FAUCET ADDRESS</p>
        <div class="address-row">
          <code id="faucet-address" class="address-code">Loading…</code>
          <button id="copy-btn" class="copy-btn" title="Copy address" disabled>Copy</button>
        </div>
      </div>

    </div>

    <p id="faucet-info-error" class="message error" role="status" hidden></p>

    <!-- FAUCET FORM CARD -->
    <div class="card form-card">
      <p class="card-label">CLAIM</p>
      <h2 class="form-title">Request XNA</h2>
      <p class="form-subtitle">Enter your Neurai address to receive free XNA tokens.</p>

      <!-- NEURAI CONNECT — hidden unless the backend has it configured -->
      <div id="connect-panel" class="connect-panel" style="display:none">
        <div class="connect-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2.5"></rect><line x1="10.5" y1="18.5" x2="13.5" y2="18.5"></line></svg>
        </div>
        <div class="connect-copy">
          <p class="connect-title">Connect with NeuraiWallet</p>
          <p class="connect-sub">Scan a QR with the app: your address is verified by signature, so there is no captcha and the XNA is sent right away.</p>
        </div>
        <button type="button" id="connect-btn" class="connect-btn">Connect</button>
      </div>

      <!-- The same slot once a wallet has been verified -->
      <div id="connected-panel" class="connected-panel" style="display:none">
        <span class="connected-check">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </span>
        <div class="connect-copy">
          <p class="connect-title">Wallet connected</p>
          <code id="connected-address" class="connected-address"></code>
        </div>
        <button type="button" id="disconnect-btn" class="copy-btn">Disconnect</button>
      </div>

      <div id="connect-divider" class="or-divider" style="display:none"><span>or enter an address manually</span></div>

      <form id="faucet-form">
        <div class="input-group">
          <label for="address">Your Neurai Address</label>
          <input
            type="text"
            id="address"
            name="address"
            placeholder="Address here"
            required
            autocomplete="off"
            spellcheck="false"
          />
        </div>

        <div id="captcha-wrapper" class="captcha-wrapper" style="display:none">
          <div id="cf-turnstile-container"></div>
        </div>

        <button type="submit" id="submit-btn" disabled>
          <span class="btn-text">Get XNA</span>
          <div class="loader hidden"></div>
        </button>
        <p class="claim-amount">You will receive <strong id="claim-amount-value">…</strong> XNA</p>
      </form>

      <div id="message" class="message hidden"></div>
    </div>

  </main>

  <!-- NEURAI CONNECT QR -->
  <div id="qr-overlay" class="qr-overlay" hidden>
    <div class="qr-modal">
      <div class="qr-head">
        <div>
          <p class="card-label">NEURAI CONNECT</p>
          <h3 class="qr-title">Scan with NeuraiWallet</h3>
        </div>
        <button type="button" id="qr-close" class="icon-btn" aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <div class="qr-frame">
        <canvas id="qr-canvas" width="260" height="260"></canvas>
        <div id="qr-spinner" class="loader qr-loader"></div>
      </div>

      <p id="qr-status" class="qr-status">Opening the connection…</p>

      <div class="qr-actions">
        <a id="qr-deeplink" class="qr-deeplink" href="#" style="display:none">Open in NeuraiWallet</a>
        <button type="button" id="qr-copy" class="copy-btn">Copy link</button>
      </div>

      <p class="qr-hint">
        Approve on your phone. The XNA goes to the address you approve there.
        <span id="qr-countdown" class="qr-countdown"></span>
      </p>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="site-footer">
    <p>© 2026 Neurai · <a href="https://neurai.org" target="_blank" rel="noopener">neurai.org</a></p>
  </footer>

</Layout>


<script>
  // ── Theme toggle ────────────────────────────────────────────────
  const themeToggle = document.getElementById('theme-toggle') as HTMLButtonElement;
  const iconMoon = document.getElementById('icon-moon') as SVGElement;
  const iconSun  = document.getElementById('icon-sun')  as SVGElement;

  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
    if (theme === 'dark') {
      iconMoon.style.display = 'none';
      iconSun.style.display  = 'block';
    } else {
      iconMoon.style.display = 'block';
      iconSun.style.display  = 'none';
    }
  }

  // Sync icon with current theme on load
  applyTheme(localStorage.getItem('theme') || 'light');

  themeToggle.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme') || 'light';
    applyTheme(current === 'dark' ? 'light' : 'dark');
  });

  let turnstileLoaded = false;
  let currentSiteKey: string | null = null;
  let turnstileWidget: string | undefined;

  function loadTurnstile(siteKey: string) {
    if (currentSiteKey === siteKey) return; // already loaded with same key
    currentSiteKey = siteKey;
    const wrapper = document.getElementById('captcha-wrapper') as HTMLElement;
    const container = document.getElementById('cf-turnstile-container') as HTMLElement;
    wrapper.style.display = 'flex';
    if (!turnstileLoaded) {
      turnstileLoaded = true;
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
      script.async = true;
      script.defer = true;
      script.onload = () => {
        turnstileWidget = (window as any).turnstile.render(container, { sitekey: siteKey });
      };
      document.head.appendChild(script);
    } else {
      turnstileWidget = (window as any).turnstile?.render(container, { sitekey: siteKey });
    }
  }

  function hideTurnstile() {
    const wrapper = document.getElementById('captcha-wrapper') as HTMLElement;
    wrapper.style.display = 'none';
    // Remove the widget, not just its wrapper: a connected wallet hides the
    // captcha and a disconnect brings it back, and `render` refuses to run
    // twice on the same container.
    if (turnstileWidget !== undefined) {
      (window as any).turnstile?.remove(turnstileWidget);
      turnstileWidget = undefined;
    }
    currentSiteKey = null;
  }

  const faucetAddrEl    = document.getElementById('faucet-address') as HTMLElement;
  const faucetBalanceEl = document.getElementById('faucet-balance') as HTMLElement;
  const networkLabel    = document.getElementById('network-label')  as HTMLElement;
  const statusDot       = document.getElementById('status-dot')     as HTMLElement;
  const copyBtn         = document.getElementById('copy-btn')        as HTMLButtonElement;
  const submitBtn_rpc   = document.getElementById('submit-btn')      as HTMLButtonElement;
  const infoErrorEl     = document.getElementById('faucet-info-error') as HTMLElement;
  let rpcOnline = false;
  let claimPending = false;
  let infoPending = false;

  function setRpcStatus(online: boolean) {
    rpcOnline = online;
    statusDot.style.background = online ? '#22c55e' : '#ef4444';
    statusDot.title = online ? 'RPC connected' : 'RPC unreachable';
    submitBtn_rpc.disabled = !online || claimPending;
    submitBtn_rpc.title = online ? '' : 'RPC unreachable — try again later';
  }

  async function updateFaucetInfo() {
    if (infoPending) return;
    infoPending = true;
    try {
      const res = await fetch('/api/info', { cache: 'no-store', signal: AbortSignal.timeout(15000) });
      if (res.ok) {
        const data = await res.json();
        const hasBalance = typeof data.balance === 'number' && Number.isFinite(data.balance);
        setRpcStatus(data.rpcOnline !== false && hasBalance);
        faucetAddrEl.textContent    = data.address;
        copyBtn.disabled = !data.address;
        faucetBalanceEl.textContent = hasBalance ? data.balance.toFixed(2) : '—';
        infoErrorEl.hidden = rpcOnline;
        infoErrorEl.textContent = rpcOnline ? '' : 'Faucet balance is temporarily unavailable. Please try again later.';
        if (data.amount !== undefined) {
          const amountEl = document.getElementById('claim-amount-value');
          if (amountEl) amountEl.textContent = data.amount;
        }
        if (data.network) {
          networkLabel.textContent =
            data.network === 'mainnet' ? 'Mainnet' : 'Testnet';
        }
        // A verified wallet replaces the captcha, so it is not shown while connected.
        if (data.turnstile && !connected) {
          loadTurnstile(data.turnstile);
        } else {
          hideTurnstile();
        }
        setConnectAvailable(data.connect ?? null);
      } else {
        throw new Error(`Faucet info request failed (HTTP ${res.status}).`);
      }
    } catch (err) {
      setRpcStatus(false);
      faucetBalanceEl.textContent = '—';
      if (copyBtn.disabled) faucetAddrEl.textContent = 'Unavailable';
      infoErrorEl.textContent = 'Faucet information is temporarily unavailable. Please try again later.';
      infoErrorEl.hidden = false;
      console.error('Error fetching faucet info:', err);
    } finally {
      infoPending = false;
    }
  }

  // Copy address
  copyBtn.addEventListener('click', () => {
    const text = faucetAddrEl.textContent || '';
    navigator.clipboard.writeText(text).then(() => {
      const orig = copyBtn.textContent;
      copyBtn.textContent = 'Copied!';
      setTimeout(() => { copyBtn.textContent = orig; }, 2000);
    });
  });

  // ── Form submission ──────────────────────────────────────────────
  const form      = document.getElementById('faucet-form')  as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn')    as HTMLButtonElement;
  const btnText   = submitBtn.querySelector('.btn-text')     as HTMLElement;
  const loader    = submitBtn.querySelector('.loader')       as HTMLElement;
  const messageEl = document.getElementById('message')       as HTMLElement;

  /**
   * The one path to `/api/claim`, shared by the manual form and by a wallet
   * that has just connected — a connected claim carries `connectTicket`
   * instead of a captcha token.
   */
  async function submitClaim(payload: { address: string; captchaToken?: string; connectTicket?: string }): Promise<boolean> {
    if (!rpcOnline || claimPending) return false;
    let sent = false;
    claimPending = true;
    submitBtn.disabled = true;
    btnText.classList.add('hidden');
    loader.classList.remove('hidden');
    messageEl.classList.add('hidden');

    try {
      const res = await fetch('/api/claim', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json();

      if (res.ok) {
        sent = true;
        messageEl.className = 'message success';
        messageEl.innerHTML = data.message;
        if (data.txid) {
          messageEl.innerHTML += `<small>TXID: ${data.txid}</small>`;
        }
      } else {
        messageEl.className = 'message error';
        messageEl.textContent = data.error || 'Something went wrong';
      }
    } catch {
      messageEl.className = 'message error';
      messageEl.textContent = 'Connection error. Is the backend running?';
    } finally {
      claimPending = false;
      submitBtn.disabled = !rpcOnline;
      btnText.classList.remove('hidden');
      loader.classList.add('hidden');
      messageEl.classList.remove('hidden');
      if ((window as any).turnstile) (window as any).turnstile.reset();
    }
    return sent;
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const address = (document.getElementById('address') as HTMLInputElement).value;
    if (connected) return void submitClaim({ address, connectTicket: connected.ticket });
    const captchaToken = (document.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement | null)?.value || undefined;
    void submitClaim({ address, captchaToken });
  });

  // ── Neurai Connect ───────────────────────────────────────────────
  // The wallet signs this faucet's own nonce with the address that will receive
  // the funds, which is what lets the backend skip the captcha. The QR panel is
  // only ever a view over that exchange: everything it shows comes from the
  // backend's authPayload.

  const addressInput  = document.getElementById('address')           as HTMLInputElement;
  const connectPanel  = document.getElementById('connect-panel')     as HTMLElement;
  const connectedPanel= document.getElementById('connected-panel')   as HTMLElement;
  const connectDiv    = document.getElementById('connect-divider')   as HTMLElement;
  const connectBtn    = document.getElementById('connect-btn')       as HTMLButtonElement;
  const disconnectBtn = document.getElementById('disconnect-btn')    as HTMLButtonElement;
  const connectedAddr = document.getElementById('connected-address') as HTMLElement;
  const overlay       = document.getElementById('qr-overlay')        as HTMLElement;
  const qrCanvas      = document.getElementById('qr-canvas')         as HTMLCanvasElement;
  const qrSpinner     = document.getElementById('qr-spinner')        as HTMLElement;
  const qrStatus      = document.getElementById('qr-status')         as HTMLElement;
  const qrCountdown   = document.getElementById('qr-countdown')      as HTMLElement;
  const qrDeepLink    = document.getElementById('qr-deeplink')       as HTMLAnchorElement;
  const qrCopy        = document.getElementById('qr-copy')           as HTMLButtonElement;
  const qrClose       = document.getElementById('qr-close')          as HTMLButtonElement;

  let connected: { address: string; ticket: string } | null = null;
  let relayUrl: string | null = null;
  let attempt: AbortController | null = null;
  let countdownTimer: number | undefined;
  let pairingUri = '';

  const shortAddress = (a: string) => (a.length > 22 ? `${a.slice(0, 12)}…${a.slice(-8)}` : a);

  function renderConnectPanels() {
    const offer = relayUrl !== null && !connected;
    connectPanel.style.display = offer ? 'flex' : 'none';
    connectDiv.style.display = offer ? 'flex' : 'none';
    connectedPanel.style.display = connected ? 'flex' : 'none';
  }

  /** Shows or hides the whole feature, from what `/api/info` reports. */
  function setConnectAvailable(info: { relayUrl: string; chainId: string } | null) {
    relayUrl = info?.relayUrl ?? null;
    renderConnectPanels();
  }

  function setConnected(result: { address: string; ticket: string } | null) {
    connected = result;
    if (result) {
      addressInput.value = result.address;
      addressInput.readOnly = true;
      connectedAddr.textContent = shortAddress(result.address);
      connectedAddr.title = result.address;
      hideTurnstile();
    } else {
      addressInput.readOnly = false;
      void updateFaucetInfo(); // brings the captcha back
    }
    renderConnectPanels();
  }

  function stopCountdown() {
    if (countdownTimer !== undefined) clearInterval(countdownTimer);
    countdownTimer = undefined;
    qrCountdown.textContent = '';
  }

  function startCountdown(expiresAt: number) {
    stopCountdown();
    const tick = () => {
      const left = Math.max(0, Math.round((expiresAt - Date.now()) / 1000));
      qrCountdown.textContent = left > 0
        ? `Expires in ${Math.floor(left / 60)}:${String(left % 60).padStart(2, '0')}.`
        : 'This request expired — close and try again.';
      if (left <= 0) stopCountdown();
    };
    tick();
    countdownTimer = window.setInterval(tick, 1000);
  }

  function closeOverlay() {
    overlay.hidden = true;
    stopCountdown();
    attempt?.abort();
    attempt = null;
  }

  async function startConnect() {
    if (!relayUrl) return;

    const { connectWallet, isUserRejection } = await import('../lib/connect');
    const { renderQr } = await import('../lib/qr');

    attempt?.abort();
    attempt = new AbortController();
    const signal = attempt.signal;

    overlay.hidden = false;
    qrCanvas.style.display = 'none';
    qrSpinner.classList.remove('hidden');
    qrStatus.textContent = 'Opening the connection…';
    qrDeepLink.style.display = 'none';
    messageEl.classList.add('hidden');
    stopCountdown();

    try {
      const result = await connectWallet(relayUrl, {
        signal,
        onStatus: (status) => {
          if (signal.aborted) return;
          qrStatus.textContent = status === 'pairing'
            ? 'Opening the connection…'
            : status === 'waiting'
              ? 'Waiting for you to approve in the app…'
              : 'Checking the signature…';
        },
        onPairing: ({ uri, deepLink, expiresAt }) => {
          if (signal.aborted) return;
          pairingUri = uri;
          qrSpinner.classList.add('hidden');
          qrCanvas.style.display = 'block';
          void renderQr(qrCanvas, uri);
          // On a phone the camera cannot scan the screen it is showing, so the
          // deep link is the way in; on a desktop it would only fail.
          if (/Android|iPhone|iPad|iPod/i.test(navigator.userAgent)) {
            qrDeepLink.href = deepLink;
            qrDeepLink.style.display = 'inline-flex';
          }
          startCountdown(expiresAt);
        },
      });

      if (signal.aborted) return;
      closeOverlay();
      setConnected({ address: result.address, ticket: result.ticket });
      // What the user asked for by scanning: no second button to press.
      const sent = await submitClaim({ address: result.address, connectTicket: result.ticket });
      // A connection pays exactly once. Once it has, offer a fresh one rather
      // than leaving a spent ticket behind the "Get XNA" button; a claim that
      // failed keeps it, because its ticket was never spent.
      if (sent) setConnected(null);
    } catch (error) {
      if (signal.aborted) return;
      closeOverlay();
      messageEl.className = 'message error';
      messageEl.textContent = isUserRejection(error)
        ? 'The wallet rejected the connection.'
        : `Could not connect: ${error instanceof Error ? error.message : String(error)}`;
      messageEl.classList.remove('hidden');
    }
  }

  connectBtn.addEventListener('click', () => void startConnect());
  qrClose.addEventListener('click', closeOverlay);
  overlay.addEventListener('click', (e) => { if (e.target === overlay) closeOverlay(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !overlay.hidden) closeOverlay(); });

  qrCopy.addEventListener('click', () => {
    if (!pairingUri) return;
    navigator.clipboard.writeText(pairingUri).then(() => {
      qrCopy.textContent = 'Copied!';
      setTimeout(() => { qrCopy.textContent = 'Copy link'; }, 2000);
    });
  });

  disconnectBtn.addEventListener('click', () => {
    addressInput.value = '';
    setConnected(null);
  });

  updateFaucetInfo();
  setInterval(updateFaucetInfo, 5000);
</script>

<style>
  /* ── Layout ─────────────────────────────────────────────────── */
  .navbar {
    background: var(--navbar-bg);
    border-bottom: 1px solid var(--card-border);
    padding: 0 2rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    position: sticky;
    top: 0;
    z-index: 100;
    transition: background 0.25s, border-color 0.25s;
  }

  .navbar-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-logo {
    width: 40px;
    height: 40px;
    object-fit: contain;
    border-radius: 50%;
  }

  .nav-title-group {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .nav-eyebrow {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--text-label);
    text-transform: uppercase;
  }

  .nav-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .navbar-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .network-pill {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--input-bg);
    border: 1px solid var(--card-border);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    flex-shrink: 0;
  }

  .icon-btn {
    background: var(--input-bg);
    border: 1px solid var(--card-border);
    color: var(--text-label);
    border-radius: 8px;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .icon-btn:hover {
    background: var(--card-border);
    color: var(--text-main);
  }

  /* ── Page Content ────────────────────────────────────────────── */
  .page-content {
    flex: 1;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* ── Cards ───────────────────────────────────────────────────── */
  .card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-card);
    box-shadow: var(--card-shadow);
    padding: 1.5rem 1.75rem;
    transition: background 0.25s, border-color 0.25s;
  }

  .card-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-label);
    margin-bottom: 0.6rem;
  }

  /* ── Top Row ─────────────────────────────────────────────────── */
  .top-row {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 1.25rem;
  }

